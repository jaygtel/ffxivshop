// Tasks for this project: run them with "task: spawn" (cmd-shift-r on macOS,
// alt-shift-t on Linux and Windows). In the dev container they run inside
// it, with its tools.
[
  {
    "label": "trunk serve",
    // Builds the site and serves it at http://localhost:8080, rebuilding and
    // reloading the page whenever you save. Stop it with ctrl-c.
    "command": "trunk serve",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "save": "all"
  },
  {
    "label": "trunk build --release",
    // The finished site, in dist/, ready to upload.
    "command": "trunk build --release",
    "save": "all"
  },
  {
    "label": "cargo test",
    "command": "cargo test --workspace",
    "save": "all"
  },
  {
    "label": "cargo clippy (site, wasm32)",
    // Lints the site for the target it actually ships to.
    "command": "cargo clippy -p ffxiv-shop --target wasm32-unknown-unknown",
    "save": "all"
  },
  {
    "label": "shop-tools: fill shop.toml",
    // Looks up the Eorzea Database link, icon, item level and jobs for every
    // item in shop.toml that has a name.
    "command": "cargo run -q -p shop-tools -- fill",
    "save": "all"
  },
  {
    "label": "shop-tools: write market prices into shop.toml",
    // Sets each item's prices in shop.toml from your world's market board, as
    // [prices] in shop.toml says. On the server this happens every week in
    // prices.json instead; the prices in shop.toml are the ones used where the
    // market has none.
    "command": "cargo run -q -p shop-tools -- prices",
    "save": "all"
  },
  {
    "label": "shop-tools: show market prices in trunk serve",
    // Writes today's market prices to dist/prices.json, as the server's
    // prices service does, so the page `trunk serve` shows uses them. Start
    // trunk serve first, then reload the page. Trunk clears dist/ when it
    // rebuilds, so run this again after changing anything.
    "command": "cargo run -q -p shop-tools -- prices --json dist/prices.json",
    "save": "all"
  },
  {
    "label": "orders service: save emails to files",
    // Runs the orders service, so Send by email works in trunk serve: each
    // order is saved in target/emails (the email as a .eml file, and its HTML
    // and plain-text copies) instead of being sent. Open the .html file in a
    // browser to see the receipt. It reads ORDER_EMAIL_FROM and
    // ORDER_EMAIL_TO from .env, and takes the receipt's pictures and fonts
    // from trunk serve. Stop it with ctrl-c.
    "command": "cargo run -q -p shop-orders -- --prices dist/prices.json --save-to target/emails --assets http://localhost:8080",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "save": "all"
  },
  {
    "label": "shop-tools: find selected item",
    // Select an item name in the editor, then run this.
    "command": "cargo",
    "args": ["run", "-q", "-p", "shop-tools", "--", "find", "$ZED_SELECTED_TEXT"]
  },
  {
    "label": "leptosfmt: format view! macros",
    // Formats Leptos view! macros, then the rest with rustfmt.
    "command": "leptosfmt src && cargo fmt --all",
    "save": "all"
  }
]
