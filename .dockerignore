# Never sent to Docker builds, so never inside an image:
# secrets and server settings
.env
.env.*
# build output, history and editor settings
target/
dist/
.git/
.devcontainer/
.zed/
*.zip
# GitHub's build check and the git hook (not needed inside images)
.github/
.githooks/
# Docker Compose files (not needed inside images)
compose*.yaml
